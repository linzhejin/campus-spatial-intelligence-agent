[Unit]
Description=WHU Walker manager vision analysis worker
After=network-online.target whu-walker.service
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/venv/bin/python -m vision.worker
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=300
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
